# Build freq_list (important)
freq_list = [0] * vocab_size
for w,i in word2idx.items():
    freq_list[i] = word_counter[w]

# Now run SGNS
W_in, W_out = train_sgns(token_ids, freq_list, vocab_size)



embedding_dim = W_in.shape[1]

