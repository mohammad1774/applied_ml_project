import numpy as np
import matplotlib.pyplot as plt
from scipy import signal

# 1. Define the Filter (Detects changes)
# This is a simple finite difference filter
f = np.array([-1., 1.])

# 2. Define the Signal (Bouncy signal)
x = np.ones(30)
x[5:8] = 0   # First gap
x[15:18] = 0 # Second gap

# 3. Perform Convolution
# mode='same' keeps the output size the same as input x for easier plotting alignment
# It effectively slides 'f' over 'x'
conv_result = signal.convolve(x, f, mode='same')

# 4. Visualization
fig, (ax1, ax2) = plt.subplots(2, 1, sharex=True, figsize=(10, 6))

# Plot Original Signal
ax1.stem(x, linefmt='b-', markerfmt='bo', basefmt='k-')
ax1.set_title('Original Signal (x): Intensity')
ax1.set_ylabel('Amplitude')
ax1.grid(True, alpha=0.3)

# Plot Convolution Result (Edges)
ax2.stem(conv_result, linefmt='r-', markerfmt='ro', basefmt='k-')
ax2.set_title('Convolution Output: Detected Edges (Change)')
ax2.set_ylabel('Gradient')
ax2.set_xlabel('Index')
ax2.grid(True, alpha=0.3)

# Highlight the edges
ax2.annotate('Falling Edge (-1)', xy=(5, -1), xytext=(7, -1.5),
             arrowprops=dict(facecolor='black', shrink=0.05))
ax2.annotate('Rising Edge (+1)', xy=(8, 1), xytext=(10, 1.5),
             arrowprops=dict(facecolor='black', shrink=0.05))

plt.tight_layout()
plt.show()



