from sklearn.feature_extraction.text import CountVectorizer

vectorizer = CountVectorizer(stop_words = 'english')
vectorizer.fit(train_df['text'])


import pandas as pd

def get_top_words_per_class(df, class_label, top_n=20):
    class_texts = df[df['label'] == class_label]['text']
    X = vectorizer.transform(class_texts)

    word_counts = np.array(X.sum(axis=0)).flatten()

    vocab = vectorizer.get_feature_names_out()

    df_counts = pd.DataFrame({'word':vocab, 'count': word_counts})
    df_counts = df_counts.sort_values(by='count', ascending=False).head(top_n)

    return df_counts


plt.figure(figsize= (16,12))
class_names = ["World", "Sports", "Business", "Sci-Tech"]

for label in range(4):
    top_words = get_top_words_per_class(train_df, label)

    plt.subplot(2,2,label+1)
    sns.barplot(
        data=top_words,
        x = 'count',
        y = 'word',
        palette = 'viridis'
    )

    plt.title(f"Top 20 words for class : {class_names[label]}")
    plt.xlabel("Count")
    plt.ylabel("Word")

plt.tight_layout()
plt.savefig("images/top_20_words.png")
plt.show()








